# =================================================================
# Avyukt Utthan Sanstha — Main Website Environment Variables
# =================================================================

# Backend API Base URL (must end with /api)
# Local: http://localhost:5001/api
# Production: https://your-backend-api.onrender.com/api
VITE_API_URL=http://localhost:5001/api

# Backend Root Domain (used to fetch /uploads images & avatars)
# Local: http://localhost:5001
# Production: https://your-backend-api.onrender.com
VITE_BACKEND_URL=http://localhost:5001

# Admin Portal URL (used for "Go to Admin Panel" redirection link)
# Local: http://localhost:5174
# Production: https://admin.your-domain.com
VITE_ADMIN_URL=http://localhost:5174
